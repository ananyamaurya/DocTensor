# DocTensor API Settings

# Application
APP_NAME="DocTensor API"
APP_VERSION="0.1.0"
DEBUG=False

# File constraints
MAX_SYNC_FILE_SIZE_MB=5
MAX_FILE_SIZE_MB=200

# Storage
STORAGE_BACKEND=local       # 'local' or 's3'
STORAGE_ROOT=./tmp_uploads  # Used if backend=local

# S3 Settings (Used if STORAGE_BACKEND=s3)
S3_BUCKET=doctensor
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Redis (Celery broker and result backend)
REDIS_URL=redis://localhost:6379/0
CELERY_CONCURRENCY=2

# Webhooks (Optional)
WEBHOOK_SECRET=change-me-in-production
WEBHOOK_TIMEOUT_SECONDS=10
